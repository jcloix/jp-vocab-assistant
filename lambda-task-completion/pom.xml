<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jcloix.jpvocab</groupId>
        <artifactId>jp-vocab</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>lambda-task-completion</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Lambda runtime -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
            <version>${aws.lambda.core.version}</version>
        </dependency>

        <!-- SQS event -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-events</artifactId>
            <version>${aws.lambda.events.version}</version>
        </dependency>

        <!-- Internal -->
        <dependency>
            <groupId>io.github.jcloix.jpvocab</groupId>
            <artifactId>util</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jcloix.jpvocab</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jcloix.jpvocab</groupId>
            <artifactId>persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jcloix.jpvocab</groupId>
            <artifactId>task-source</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jcloix.jpvocab</groupId>
            <artifactId>notification</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>
                                        io.github.jcloix.jpvocab.handler.TaskWorkerHandler
                                    </mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
